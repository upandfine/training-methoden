# Copy this to .env and adjust if needed.

# ----------------------------------------------------------------------
# Postgres
# ----------------------------------------------------------------------

POSTGRES_USER=methods
POSTGRES_PASSWORD=methods
POSTGRES_DB=methods

# Host-Port für Postgres. Default: 55432 (NICHT 5432, weil DDEV den selbst
# belegt). Muss mit dem Port in DATABASE_URL unten übereinstimmen.
POSTGRES_PORT=55432

# Connect-String für Alembic + die App, wenn sie NATIV (außerhalb des
# Containers) laufen — also lokales `make api` oder `make migrate`.
# Im Container nutzt der app-Service eine andere URL (db:5432, kein localhost),
# die wird in docker-compose.yml direkt gesetzt.
DATABASE_URL=postgresql+psycopg://methods:methods@localhost:55432/methods

# ----------------------------------------------------------------------
# OpenAI (semantische Suche)
# ----------------------------------------------------------------------

# Pflicht für /search?mode=semantic und für `make embed`.
# Ohne den Key läuft /search?mode=hybrid rein lexikalisch.
# Empfehlung: keinen Key in dieses File comitten — .env ist in .gitignore.
OPENAI_API_KEY=

# Welches Embedding-Modell. Muss 1536-dim ausgeben oder per --dimensions
# auf 1536 getrimmt werden, weil die DB-Spalte fix dimensioniert ist.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------
# Microservice-Deployment
# ----------------------------------------------------------------------

# CORS-Origins für die FastAPI-App. Komma-separierte Liste.
# Default "*" für lokales Entwickeln — in Prod auf konkrete Frontend-URLs.
CORS_ORIGINS=*

# Gunicorn-Worker-Anzahl im Container. 4 ist okay für 1-2 vCPUs.
WEB_CONCURRENCY=4

# Host-Port, unter dem der app-Container erreichbar ist.
API_PORT=8765
